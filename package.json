{
  "name": "todo-list-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm run --filter web dev",
    "build": "pnpm run --filter web build",
    "start": "pnpm run --filter web start",
    "build:packages": "pnpm run -r --filter \"./packages/*\" build",
    "clean": "pnpm run -r clean && rm -rf node_modules",
    "lint": "pnpm run -r lint"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0",
    "next": "latest"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
